{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repo Creator",
  "version": "1.4.0",
  "identifier": "com.definitivedcode.repocreator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Repo Creator",
        "width": 1100,
        "height": 740,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Create and configure local and GitHub repositories.",
    "copyright": "Copyright © 2026 DefinitivedCode",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
